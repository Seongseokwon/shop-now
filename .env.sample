# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# Kakao JavaScript App Key (https://developers.kakao.com)
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_app_key

# Coupang Partners ID (https://partners.coupang.com)
NEXT_PUBLIC_COUPANG_PARTNER_ID=your_coupang_partner_id

# Deployment base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
